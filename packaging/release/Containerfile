# Release-builder image: Ubuntu 22.04 (glibc 2.35, Qt 6.2), so the released
# binaries run on any distro from that era on. Used by
# .gitea/workflows/release.yml; the GUI code must stay Qt 6.2 compatible.
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:$PATH

# lld is required: .cargo/config.toml links with it (cxx-qt bridge symbols).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang lld cmake pkg-config git curl ca-certificates file \
    libdbus-1-dev \
    qt6-base-dev qt6-base-dev-tools qt6-declarative-dev libqt6svg6-dev \
    qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts \
    qml6-module-qtquick-templates qml6-module-qtquick-window qml6-module-qtqml-workerscript \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable

WORKDIR /workspace
